{
  "manifest_version": 3,
  "name": "QR Code Recognition",
  "version": "1.0.0",
  "description": "截图识别页面中的二维码并展示解析结果。",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "识别当前页面二维码"
  },
  "commands": {
    "capture-and-decode": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "Command+Shift+Q"
      },
      "description": "截图并识别二维码"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
